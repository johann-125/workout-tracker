# Copy to .env for local dev, or set these in Vercel Project Settings > Environment Variables.

# Neon Postgres connection string (use the "pooled" variant from the Neon dashboard).
DATABASE_URL=postgres://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require

# Random secret for Flask session signing, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: enables AI workout recommendations.
ANTHROPIC_API_KEY=
